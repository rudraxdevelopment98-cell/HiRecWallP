# =============================================================================
# HirecWallp — environment variables (Phase 1)
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle.
# =============================================================================

# --- Brand / site ---------------------------------------------------------
BRAND_NAME="HirecWallp"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Show the 6-digit email code box on /login (needs custom SMTP + {{ .Token }} in templates)
NEXT_PUBLIC_AUTH_EMAIL_CODE=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Cloudflare R2 (S3 API) ------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Private bucket: full-resolution originals. NO public access.
R2_PRIVATE_BUCKET=""
# Public bucket: watermarked previews, served behind the CDN.
R2_PUBLIC_BUCKET=""
# Public base URL/CDN host for the public bucket, e.g. https://cdn.hirecwallp.com
R2_PUBLIC_BASE_URL=""

# --- Payments: Razorpay (Phase 1) ------------------------------------------
# NOTE: do not wire payments until folder structure + SQL migration are confirmed.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Secure download -------------------------------------------------------
# Secret used to sign short-lived download tokens / HMAC payloads.
DOWNLOAD_TOKEN_SECRET=""

# --- Forensic watermark worker (Phase 2) -----------------------------------
# Deploy worker/ separately (see worker/README.md). When both are set, paid
# downloads are watermarked with the order id (cached per entitlement).
WATERMARK_WORKER_URL=""
WATERMARK_WORKER_SECRET=""

# --- AI providers (adapters; Phase 2 for generation) -----------------------
IMAGE_PROVIDER=""
IMAGE_PROVIDER_API_KEY=""
UPSCALE_PROVIDER=""
UPSCALE_PROVIDER_API_KEY=""
# Claude API for metadata / quality review (vision)
ANTHROPIC_API_KEY=""

# --- Social (Phase 2) ------------------------------------------------------
IG_BUSINESS_ACCOUNT_ID=""
IG_ACCESS_TOKEN=""
PINTEREST_ACCESS_TOKEN=""
PINTEREST_BOARD_IDS=""

# --- Email -----------------------------------------------------------------
RESEND_API_KEY=""

# --- Creator payouts (Phase 3) ---------------------------------------------
# Razorpay Route (India) reuses RAZORPAY_* above. PayPal Payouts (international):
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# --- Scheduled jobs --------------------------------------------------------
# Shared secret to authenticate Vercel Cron / GitHub Action job calls.
# Vercel injects "Authorization: Bearer $CRON_SECRET" on cron requests.
CRON_SECRET=""
# Recipient for the weekly owner report (Phase 2). If unset, the job no-ops.
OWNER_EMAIL=""
